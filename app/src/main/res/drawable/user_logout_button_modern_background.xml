<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 按下状态 -->
    <item android:state_pressed="true">
        <layer-list>
            <!-- 外层发光 -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#40FF6B6B" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            
            <!-- 内层主体 -->
            <item android:top="3dp" android:left="3dp" android:right="3dp" android:bottom="3dp">
                <shape android:shape="rectangle">
                    <solid android:color="#E53E3E" />
                    <corners android:radius="13dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    
    <!-- 普通状态 -->
    <item>
        <layer-list>
            <!-- 外层发光 -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#30FF6B6B" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            
            <!-- 中层阴影 -->
            <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="#20FF6B6B" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            
            <!-- 内层主体 -->
            <item android:top="4dp" android:left="4dp" android:right="4dp" android:bottom="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="#FFFFFF" />
                    <corners android:radius="12dp" />
                    <stroke android:width="1dp" android:color="#FFE6E6" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>