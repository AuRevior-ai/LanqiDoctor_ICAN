<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 选中状态 -->
    <item android:state_selected="true">
        <layer-list>
            <!-- 外层发光 -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#205B9FFF" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
            
            <!-- 中层阴影 -->
            <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="#155B9FFF" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
            
            <!-- 内层主体 -->
            <item android:top="4dp" android:left="4dp" android:right="4dp" android:bottom="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="#E3F2FD" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            
            <!-- 底部指示线 -->
            <item android:top="32dp" android:left="16dp" android:right="16dp" android:bottom="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="#5B9FFF" />
                    <corners android:radius="2dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    
    <!-- 按下状态 -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#10E0E0E0" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    
    <!-- 普通状态 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>