<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 按压状态 -->
    <item android:state_pressed="true">
        <layer-list>
            <!-- 外层强化发光 -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#3A84E8B4" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            
            <!-- 中层增强光晕 -->
            <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="#4A84E8B4" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            
            <!-- 内层背景 -->
            <item android:top="4dp" android:left="4dp" android:right="4dp" android:bottom="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="#FFFFFF" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    
    <!-- 默认状态 -->
    <item>
        <layer-list>
            <!-- 外层发光效果 -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#2A84E8B4" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            
            <!-- 中层柔和光晕 -->
            <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="#3A84E8B4" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            
            <!-- 内层背景 -->
            <item android:top="4dp" android:left="4dp" android:right="4dp" android:bottom="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="#FFFFFF" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>