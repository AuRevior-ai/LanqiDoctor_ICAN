<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 外层发光效果 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#157AC8E8" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    
    <!-- 中层阴影 -->
    <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#107AC8E8" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    
    <!-- 内层主体 -->
    <item android:top="4dp" android:left="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="#E0F7FA" />
        </shape>
    </item>
</layer-list>