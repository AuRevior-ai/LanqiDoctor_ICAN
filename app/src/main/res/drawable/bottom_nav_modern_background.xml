<?xml version="1.0" encoding="utf-8"?>
<!-- 底部导航栏现代化荧光背景 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- 外层荧光效果 - 顶部圆角 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#305B9FFF" />
            <corners 
                android:topLeftRadius="@dimen/dp_20"
                android:topRightRadius="@dimen/dp_20" />
        </shape>
    </item>
    
    <!-- 主背景层 - 白色 -->
    <item 
        android:left="@dimen/dp_2"
        android:top="@dimen/dp_4" 
        android:right="@dimen/dp_2"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/card_background" />
            <corners 
                android:topLeftRadius="@dimen/dp_18"
                android:topRightRadius="@dimen/dp_18" />
        </shape>
    </item>
    
</layer-list>
