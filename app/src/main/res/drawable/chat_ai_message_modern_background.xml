<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 外层发光效果 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1584E8B4" />
            <corners 
                android:topLeftRadius="18dp"
                android:topRightRadius="18dp"
                android:bottomLeftRadius="4dp"
                android:bottomRightRadius="18dp" />
        </shape>
    </item>
    
    <!-- 中层阴影 -->
    <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#1084E8B4" />
            <corners 
                android:topLeftRadius="16dp"
                android:topRightRadius="16dp"
                android:bottomLeftRadius="3dp"
                android:bottomRightRadius="16dp" />
        </shape>
    </item>
    
    <!-- 内层主体 -->
    <item android:top="4dp" android:left="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#F0FFF0" />
            <corners 
                android:topLeftRadius="14dp"
                android:topRightRadius="14dp"
                android:bottomLeftRadius="2dp"
                android:bottomRightRadius="14dp" />
        </shape>
    </item>
</layer-list>