<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blue_gradient_start"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/dp_16">

        <!-- 标题区域 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="健康助手"
            android:textSize="@dimen/sp_24"
            android:textStyle="bold"
            android:textColor="@color/text_on_blue"
            android:gravity="center"
            android:layout_marginBottom="@dimen/dp_24" />

        <!-- 健康数据卡片区域 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="健康数据概览"
            android:textSize="@dimen/sp_18"
            android:textStyle="bold"
            android:textColor="@color/text_on_blue"
            android:layout_marginBottom="@dimen/dp_16" />

        <!-- 步数数据卡片 - 现代化绿色荧光主题 -->
        <LinearLayout
            android:id="@+id/card_steps_data"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_16"
            android:layout_marginHorizontal="@dimen/dp_4"
            android:orientation="horizontal"
            android:background="@drawable/health_steps_card_background"
            android:padding="@dimen/dp_20"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:elevation="@dimen/dp_6">

            <!-- 现代化图标设计 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/circle_green_background"
                android:padding="@dimen/dp_2">
                
                <ImageView
                    android:layout_width="@dimen/dp_48"
                    android:layout_height="@dimen/dp_48"
                    android:background="@drawable/circle_white_background"
                    android:padding="@dimen/dp_12"
                    android:src="@drawable/directions_walk_ic"
                    android:contentDescription="步数统计"
                    app:tint="@color/neon_green" />
                    
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="@dimen/dp_20">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="今日步数"
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/tv_steps_data"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="加载中..."
                    android:textSize="@dimen/sp_20"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginTop="@dimen/dp_6" />

            </LinearLayout>

            <!-- 右侧箭头 -->
            <ImageView
                android:layout_width="@dimen/dp_20"
                android:layout_height="@dimen/dp_20"
                android:src="@drawable/ic_arrow_right"
                app:tint="@color/neon_green" />

        </LinearLayout>

        <!-- 心率数据卡片 - 现代化橙色荧光主题 -->
        <LinearLayout
            android:id="@+id/card_heart_rate_data"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_16"
            android:layout_marginHorizontal="@dimen/dp_4"
            android:orientation="horizontal"
            android:background="@drawable/health_heart_card_background"
            android:padding="@dimen/dp_20"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:elevation="@dimen/dp_6">

            <!-- 现代化图标设计 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/circle_pink_background"
                android:padding="@dimen/dp_2">
                
                <ImageView
                    android:layout_width="@dimen/dp_48"
                    android:layout_height="@dimen/dp_48"
                    android:background="@drawable/circle_white_background"
                    android:padding="@dimen/dp_12"
                    android:src="@drawable/ic_heart"
                    android:contentDescription="心率监测"
                    app:tint="@color/neon_orange" />
                    
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="@dimen/dp_20">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="心率监测"
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/tv_heart_rate_data"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="加载中..."
                    android:textSize="@dimen/sp_20"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginTop="@dimen/dp_6" />

            </LinearLayout>

            <!-- 右侧箭头 -->
            <ImageView
                android:layout_width="@dimen/dp_20"
                android:layout_height="@dimen/dp_20"
                android:src="@drawable/ic_arrow_right"
                app:tint="@color/neon_orange" />

        </LinearLayout>

        <!-- 睡眠数据卡片 - 现代化蓝色荧光主题 -->
        <LinearLayout
            android:id="@+id/card_sleep_data"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_24"
            android:layout_marginHorizontal="@dimen/dp_4"
            android:orientation="horizontal"
            android:background="@drawable/health_sleep_card_background"
            android:padding="@dimen/dp_20"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:elevation="@dimen/dp_6">

            <!-- 现代化图标设计 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/circle_blue_background"
                android:padding="@dimen/dp_2">
                
                <ImageView
                    android:layout_width="@dimen/dp_48"
                    android:layout_height="@dimen/dp_48"
                    android:background="@drawable/circle_white_background"
                    android:padding="@dimen/dp_12"
                    android:src="@drawable/bedtime_ic"
                    android:contentDescription="睡眠质量"
                    app:tint="@color/neon_blue" />
                    
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="@dimen/dp_20">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="睡眠质量"
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/tv_sleep_data"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="7小时30分"
                    android:textSize="@dimen/sp_20"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginTop="@dimen/dp_6" />

            </LinearLayout>

            <!-- 右侧箭头 -->
            <ImageView
                android:layout_width="@dimen/dp_20"
                android:layout_height="@dimen/dp_20"
                android:src="@drawable/ic_arrow_right"
                app:tint="@color/neon_blue" />

        </LinearLayout>

        <!-- 功能按钮区域 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="健康功能"
            android:textSize="@dimen/sp_18"
            android:textStyle="bold"
            android:textColor="@color/text_on_blue"
            android:layout_marginBottom="@dimen/dp_16" />

        <!-- 功能按钮网格 2x2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 第一行：数据同步 + 个人健康画像 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="@dimen/dp_16">

                <!-- 数据同步 - 青绿色荧光主题 -->
                <LinearLayout
                    android:id="@+id/ll_data_sync"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_90"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/health_sync_button_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginEnd="@dimen/dp_8"
                    android:elevation="@dimen/dp_4">

                    <ImageView
                        android:layout_width="@dimen/dp_36"
                        android:layout_height="@dimen/dp_36"
                        android:src="@drawable/sync_ic"
                        android:contentDescription="数据同步"
                        app:tint="@color/neon_teal" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="数据同步"
                        android:textSize="@dimen/sp_13"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginTop="@dimen/dp_8" />

                </LinearLayout>

                <!-- 个人健康画像 - 绿色荧光主题 -->
                <LinearLayout
                    android:id="@+id/ll_health_profile"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_90"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/health_profile_button_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginStart="@dimen/dp_8"
                    android:elevation="@dimen/dp_4">

                    <ImageView
                        android:layout_width="@dimen/dp_36"
                        android:layout_height="@dimen/dp_36"
                        android:src="@drawable/assessment_ic"
                        android:contentDescription="个人健康画像"
                        app:tint="@color/neon_green" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="个人健康画像"
                        android:textSize="@dimen/sp_13"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginTop="@dimen/dp_8" />

                </LinearLayout>

            </LinearLayout>

            <!-- 第二行：我的食谱 + 习惯培养 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- 我的食谱 - 橙色荧光主题 -->
                <LinearLayout
                    android:id="@+id/ll_my_recipes"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_90"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/health_recipes_button_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginEnd="@dimen/dp_8"
                    android:elevation="@dimen/dp_4">

                    <ImageView
                        android:layout_width="@dimen/dp_36"
                        android:layout_height="@dimen/dp_36"
                        android:src="@drawable/ic_restaurant"
                        android:contentDescription="我的食谱"
                        app:tint="@color/neon_orange" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="我的食谱"
                        android:textSize="@dimen/sp_13"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginTop="@dimen/dp_8" />

                </LinearLayout>

                <!-- 习惯培养 - 蓝色荧光主题 -->
                <LinearLayout
                    android:id="@+id/ll_habit_building"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_90"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/health_habits_button_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginStart="@dimen/dp_8"
                    android:elevation="@dimen/dp_4">

                    <ImageView
                        android:layout_width="@dimen/dp_36"
                        android:layout_height="@dimen/dp_36"
                        android:src="@drawable/ic_check_circle"
                        android:contentDescription="习惯培养"
                        app:tint="@color/neon_blue" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="习惯培养"
                        android:textSize="@dimen/sp_13"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginTop="@dimen/dp_8" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- 使用说明 - 现代化风格 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_24"
            android:layout_marginHorizontal="@dimen/dp_4"
            android:background="@drawable/soft_card_background"
            android:padding="@dimen/dp_20"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💡 使用指南"
                android:textSize="@dimen/sp_16"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="@dimen/dp_12" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔄 数据同步：将健康数据保存到本地\n📊 个人健康画像：查看个人健康报告\n🍎 我的食谱：管理健康饮食方案\n⭐ 习惯培养：建立良好生活习惯\n\n⚠️ 因缺少vivo开发者账号，所有数据均为模拟生成，仅供演示"
                android:textSize="@dimen/sp_13"
                android:textColor="@color/text_secondary"
                android:lineSpacingExtra="@dimen/dp_4" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>