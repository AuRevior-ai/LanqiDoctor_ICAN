<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.lanqiDoctor.demo.widget.StatusLayout
        android:id="@+id/hl_status_hint"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_chat_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="@dimen/dp_15"
            android:paddingVertical="@dimen/dp_10" />

    </com.lanqiDoctor.demo.widget.StatusLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/dp_15"
        android:gravity="center_vertical"
        android:background="@drawable/chat_input_area_background"
        android:elevation="@dimen/dp_4">

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/et_message"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/chat_input_modern_background"
            android:hint="发消息或输入说话..."
            android:maxLines="5"
            android:minHeight="@dimen/dp_48"
            android:padding="@dimen/dp_12"
            android:textSize="@dimen/sp_14"
            android:textColorHint="#B0BEC5" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_send"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_48"
            android:layout_marginStart="@dimen/dp_10"
            android:minWidth="@dimen/dp_72"
            android:text="发送"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_14"
            android:background="@drawable/chat_send_button_background"
            android:elevation="@dimen/dp_2" />

    </LinearLayout>

</LinearLayout>