<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/health_gradient_background">

    <!-- 标题 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="实时语音对话"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:gravity="center"
        android:layout_marginBottom="12dp"
        android:paddingTop="8dp" />

    <!-- 耳机提醒区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/soft_card_background"
        android:padding="12dp"
        android:layout_marginBottom="12dp"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_headphones"
            android:layout_marginEnd="8dp"
            android:tint="@color/neon_orange"
            android:contentDescription="耳机图标" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⚠️ 请佩戴耳机使用，避免回声问题"
            android:textSize="12sp"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- 状态显示区域 -->
    <TextView
        android:id="@+id/tv_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="准备就绪"
        android:textSize="14sp"
        android:textColor="@color/text_primary"
        android:gravity="center"
        android:layout_marginBottom="20dp"
        android:padding="12dp"
        android:background="@drawable/soft_card_background"
        android:minHeight="64dp" />

    <!-- 按钮区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="20dp">

        <Button
            android:id="@+id/btn_start"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="开始对话"
            android:textSize="14sp"
            android:textColor="@color/white"
            android:background="@drawable/cloud_button_green" />

        <Button
            android:id="@+id/btn_stop"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="停止对话"
            android:textSize="14sp"
            android:textColor="@color/white"
            android:background="@drawable/cloud_button_orange" />

    </LinearLayout>

    <!-- 麦克风图标 -->
    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_mic"
        android:tint="@color/neon_blue"
        android:layout_marginBottom="16dp"
        android:contentDescription="麦克风图标" />

    <!-- 使用说明 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="使用说明：\n\n1. 请务必佩戴耳机，避免回声干扰\n2. 点击“开始对话”按钮开始语音交互\n3. 对着麦克风说话，系统会实时处理\n4. 点击“停止对话”结束会话\n5. 请确保网络连接正常"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:lineSpacingMultiplier="1.2"
        android:padding="12dp"
        android:background="@drawable/soft_card_background" />

</LinearLayout>