<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/user_page_background_gradient">

    <!-- 顶部导航栏 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/dp_40"
        android:paddingHorizontal="@dimen/dp_16"
        android:paddingBottom="@dimen/dp_16">

        <!-- 返回按钮 -->
        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="@dimen/dp_40"
            android:layout_height="@dimen/dp_40"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:padding="@dimen/dp_8"
            android:src="@drawable/arrows_left_ic"
            android:contentDescription="返回"
            android:background="@drawable/user_avatar_modern_background"
            app:tint="@color/white" />

        <!-- 页面标题 -->
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="用户信息"
            android:textColor="#333333"
            android:textSize="@dimen/sp_20"
            android:textStyle="bold" />

    </RelativeLayout>

    <!-- 用户信息卡片 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dp_20"
        android:layout_marginTop="@dimen/dp_16"
        android:background="@drawable/user_info_card_modern_background"
        android:orientation="horizontal"
        android:padding="@dimen/dp_24"
        android:elevation="@dimen/dp_6">

        <!-- 用户头像 -->
        <ImageView
            android:id="@+id/iv_user_avatar"
            android:layout_width="@dimen/dp_80"
            android:layout_height="@dimen/dp_80"
            android:background="@drawable/user_avatar_modern_background"
            android:padding="@dimen/dp_20"
            android:src="@drawable/person_ic"
            android:contentDescription="用户头像"
            app:tint="@color/white" />

        <!-- 用户信息 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_user_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AuRevior"
                android:textSize="@dimen/sp_20"
                android:textStyle="bold"
                android:textColor="#333333" />

            <TextView
                android:id="@+id/tv_user_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_8"
                android:text="注册时间: 2025年10月 • 邮箱: 未验证"
                android:textSize="@dimen/sp_12"
                android:textColor="#666666"
                android:lineSpacingExtra="@dimen/dp_2" />

        </LinearLayout>

    </LinearLayout>

    <!-- 功能选项列表 -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/dp_20">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/dp_20"
            android:paddingBottom="@dimen/dp_20">

            <!-- 个人资料 -->
            <LinearLayout
                android:id="@+id/ll_personal_info"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_52"
                android:layout_marginBottom="@dimen/dp_12"
                android:orientation="horizontal"
                android:background="@drawable/user_menu_item_modern_background"
                android:padding="@dimen/dp_16"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="@dimen/dp_24"
                    android:layout_height="@dimen/dp_24"
                    android:src="@drawable/person_ic"
                    android:contentDescription="个人资料"
                    app:tint="@color/colorPrimary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/dp_16"
                    android:layout_gravity="center_vertical"
                    android:text="个人资料"
                    android:textSize="@dimen/sp_16"
                    android:textColor="#333333" />

                <ImageView
                    android:layout_width="@dimen/dp_16"
                    android:layout_height="@dimen/dp_16"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/ic_arrow_right"
                    android:contentDescription="进入"
                    app:tint="#999999" />

            </LinearLayout>

            <!-- 偏好设置（取代原来的应用设置） -->
            <LinearLayout
                android:id="@+id/ll_preferences"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_52"
                android:layout_marginBottom="@dimen/dp_12"
                android:orientation="horizontal"
                android:background="@drawable/user_menu_item_modern_background"
                android:padding="@dimen/dp_16"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="@dimen/dp_24"
                    android:layout_height="@dimen/dp_24"
                    android:src="@drawable/settings_ic"
                    android:contentDescription="偏好设置"
                    app:tint="#FF9B7A" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/dp_16"
                    android:layout_gravity="center_vertical"
                    android:text="偏好设置"
                    android:textSize="@dimen/sp_16"
                    android:textColor="#333333" />

                <ImageView
                    android:layout_width="@dimen/dp_16"
                    android:layout_height="@dimen/dp_16"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/ic_arrow_right"
                    android:contentDescription="进入"
                    app:tint="#999999" />

            </LinearLayout>

            <!-- 隐私安全 -->
            <LinearLayout
                android:id="@+id/ll_privacy"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_52"
                android:layout_marginBottom="@dimen/dp_12"
                android:orientation="horizontal"
                android:background="@drawable/user_menu_item_modern_background"
                android:padding="@dimen/dp_16"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="@dimen/dp_24"
                    android:layout_height="@dimen/dp_24"
                    android:src="@drawable/security_ic"
                    android:contentDescription="隐私安全"
                    app:tint="#7AC8E8" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/dp_16"
                    android:layout_gravity="center_vertical"
                    android:text="隐私安全"
                    android:textSize="@dimen/sp_16"
                    android:textColor="#333333" />

                <ImageView
                    android:layout_width="@dimen/dp_16"
                    android:layout_height="@dimen/dp_16"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/ic_arrow_right"
                    android:contentDescription="进入"
                    app:tint="#999999" />

            </LinearLayout>

            <!-- 关于我们 -->
            <LinearLayout
                android:id="@+id/ll_about"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_52"
                android:layout_marginBottom="@dimen/dp_12"
                android:orientation="horizontal"
                android:background="@drawable/user_menu_item_modern_background"
                android:padding="@dimen/dp_16"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="@dimen/dp_24"
                    android:layout_height="@dimen/dp_24"
                    android:src="@drawable/info_ic"
                    android:contentDescription="关于我们"
                    app:tint="#84E8B4" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/dp_16"
                    android:layout_gravity="center_vertical"
                    android:text="关于我们"
                    android:textSize="@dimen/sp_16"
                    android:textColor="#333333" />

                <ImageView
                    android:layout_width="@dimen/dp_16"
                    android:layout_height="@dimen/dp_16"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/ic_arrow_right"
                    android:contentDescription="进入"
                    app:tint="#999999" />

            </LinearLayout>

            <!-- 退出登录 -->
            <LinearLayout
                android:id="@+id/ll_logout"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_52"
                android:layout_marginTop="@dimen/dp_24"
                android:orientation="horizontal"
                android:background="@drawable/user_logout_button_modern_background"
                android:padding="@dimen/dp_16"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center">

                <ImageView
                    android:layout_width="@dimen/dp_24"
                    android:layout_height="@dimen/dp_24"
                    android:src="@drawable/exit_to_app_ic"
                    android:contentDescription="退出登录"
                    app:tint="#FFFF5722" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_16"
                    android:text="退出登录"
                    android:textSize="@dimen/sp_16"
                    android:textStyle="bold"
                    android:textColor="#FFFF5722" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>