<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/calendar_page_background_gradient"
    android:padding="@dimen/dp_20">

    <!-- 现代风格标题卡片 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/calendar_modern_background"
        android:padding="@dimen/dp_24"
        android:layout_marginBottom="@dimen/dp_24"
        android:elevation="@dimen/dp_8">
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="健康轨迹日历"
            android:textSize="@dimen/sp_24"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="@dimen/dp_8" />
            
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="查看您的每日服药记录和健康趋势"
            android:textSize="@dimen/sp_14"
            android:textColor="#666666" />

    </LinearLayout>

    <!-- 月份切换栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/calendar_modern_background"
        android:padding="@dimen/dp_20"
        android:layout_marginBottom="@dimen/dp_20"
        android:elevation="@dimen/dp_6">

        <Button
            android:id="@+id/btn_prev"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_48"
            android:text="◄ 上月"
            android:background="@drawable/calendar_button_modern_background"
            android:textColor="#5B9FFF"
            android:textSize="@dimen/sp_14"
            android:textStyle="bold"
            android:paddingHorizontal="@dimen/dp_20"
            android:stateListAnimator="@null"
            android:elevation="@dimen/dp_4"/>

        <TextView
            android:id="@+id/month_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textSize="@dimen/sp_20"
            android:textStyle="bold"
            android:textColor="#333333"/>

        <Button
            android:id="@+id/btn_next"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_48"
            android:text="下月 ►"
            android:background="@drawable/calendar_button_modern_background"
            android:textColor="#5B9FFF"
            android:textSize="@dimen/sp_14"
            android:textStyle="bold"
            android:paddingHorizontal="@dimen/dp_20"
            android:stateListAnimator="@null"
            android:elevation="@dimen/dp_4"/>
    </LinearLayout>

    <!-- 日历视图容器 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/calendar_modern_background"
        android:padding="@dimen/dp_16"
        android:elevation="@dimen/dp_8">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.lanqiDoctor.demo.View.CalendarView
                android:id="@+id/calendar_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </ScrollView>
    </LinearLayout>
</LinearLayout>