<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:paddingHorizontal="@dimen/dp_16"
    android:paddingVertical="@dimen/dp_4"
    android:background="@drawable/tab_item_background_selector"
    android:clickable="true"
    android:focusable="true"
    tools:context="com.lanqiDoctor.demo.ui.adapter.TabAdapter">

    <com.hjq.shape.view.ShapeTextView
        android:id="@+id/tv_tab_design_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/dp_12"
        android:paddingHorizontal="@dimen/dp_8"
        android:textSize="@dimen/sp_15"
        android:textStyle="bold"
        app:shape_textColor="#666666"
        app:shape_textSelectedColor="@color/neon_blue"
        tools:text="我是标签" />

    <View
        android:id="@+id/v_tab_design_line"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_3"
        android:layout_alignStart="@id/tv_tab_design_title"
        android:layout_alignEnd="@id/tv_tab_design_title"
        android:layout_alignBottom="@id/tv_tab_design_title"
        android:layout_marginHorizontal="@dimen/dp_8"
        android:background="@drawable/tab_indicator_modern" />

</RelativeLayout>