<?xml version="1.0" encoding="utf-8"?>
<!-- 日常服药页面 - 个性目标设置 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blue_gradient_start"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/dp_16">

        <!-- 个性目标设置卡片 - 现代化柔和风格 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/soft_card_background"
            android:orientation="vertical"
            android:padding="@dimen/dp_20">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="请选择你的个性目标："
                android:textSize="@dimen/sp_15"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

                <!-- 目标选项 - 现代化云朵样式 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_16"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <!-- 在用药 - 蓝色荧光 -->
                    <LinearLayout
                        android:id="@+id/ll_goal_medicine"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/dp_8"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/goal_medicine_button_background"
                        android:padding="@dimen/dp_16"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="@dimen/dp_32"
                            android:layout_height="@dimen/dp_32"
                            android:src="@drawable/medical_ic"
                            android:contentDescription="在用药"
                            app:tint="@android:color/white" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_8"
                            android:text="在用药"
                            android:textSize="@dimen/sp_13"
                            android:textStyle="bold"
                            android:textColor="@android:color/white" />

                    </LinearLayout>

                    <!-- 医嘱识别 - 青绿色荧光 -->
                    <LinearLayout
                        android:id="@+id/ll_goal_diagnosis"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="@dimen/dp_8"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/goal_diagnosis_button_background"
                        android:padding="@dimen/dp_16"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="@dimen/dp_32"
                            android:layout_height="@dimen/dp_32"
                            android:src="@drawable/camera_ic"
                            android:contentDescription="医嘱识别"
                            app:tint="@android:color/white" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_8"
                            android:text="医嘱识别"
                            android:textSize="@dimen/sp_13"
                            android:textStyle="bold"
                            android:textColor="@android:color/white" />

                    </LinearLayout>

                    <!-- 服药时间 - 绿色荧光 -->
                    <LinearLayout
                        android:id="@+id/ll_goal_photo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/dp_8"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/goal_time_button_background"
                        android:padding="@dimen/dp_16"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="@dimen/dp_32"
                            android:layout_height="@dimen/dp_32"
                            android:src="@drawable/ic_clock"
                            android:contentDescription="服药时间"
                            app:tint="@android:color/white" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_8"
                            android:text="服药时间"
                            android:textSize="@dimen/sp_13"
                            android:textStyle="bold"
                            android:textColor="@android:color/white" />

                    </LinearLayout>

                </LinearLayout>

        </LinearLayout>

    <!-- 健康轨迹可视化卡片 -->
    <LinearLayout
        android:id="@+id/ll_health_track"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_140"
        android:orientation="horizontal"
        android:background="@drawable/health_track_card_modern_background"
        android:clickable="true"
        android:focusable="true"
        android:padding="@dimen/dp_24"
        android:layout_marginTop="@dimen/dp_32"
        android:layout_marginHorizontal="@dimen/dp_16"
        android:elevation="@dimen/dp_8">

        <!-- 左侧介绍内容 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingTop="@dimen/dp_16"
            android:paddingBottom="@dimen/dp_8">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="健康轨迹"
                android:textSize="@dimen/sp_20"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginTop="@dimen/dp_4"
                android:paddingBottom="@dimen/dp_4" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_8"
                android:text="查看您的用药情况"
                android:textSize="@dimen/sp_14"
                android:textColor="#666666"
                android:lineSpacingExtra="@dimen/dp_2" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:text="点击查看详细报告 →"
                android:textSize="@dimen/sp_12"
                android:textColor="#84E8B4"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- 右侧图标 -->
        <ImageView
            android:layout_width="@dimen/dp_80"
            android:layout_height="@dimen/dp_80"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/dp_16"
            android:src="@drawable/assessment_ic"
            android:contentDescription="健康轨迹"
            app:tint="#84E8B4" />

    </LinearLayout>

    </LinearLayout>

</ScrollView>
